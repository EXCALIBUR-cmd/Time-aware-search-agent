# Only GROQ_API_KEY and TAVILY_API_KEY are required. Leave any other line empty to use its default.

# REQUIRED: Groq API key, used for the main and the small model (https://console.groq.com/keys)
GROQ_API_KEY=
# REQUIRED: Tavily API key, used for web search (https://app.tavily.com)
TAVILY_API_KEY=

# Optional: fixed clock (ISO 8601) for replaying dated scenarios, e.g. 2026-11-09T10:00:00+05:30 (default: real time)
AGENT_NOW=
# Optional: SQLite file to use (default data/agent.db; `npm run demo` sets data/demo.db itself)
DB_PATH=
# Optional: timezone used to resolve date phrases (default Asia/Kolkata)
AGENT_TZ=
# Optional: Groq model that writes answers (default openai/gpt-oss-120b)
MAIN_MODEL=
# Optional: Groq model for routing and extracting claims and user facts (default openai/gpt-oss-20b)
FAST_MODEL=
